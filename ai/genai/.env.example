# Konfigurasi Layanan AI Inventory Assistant (ROKKUS Project)
# Salin file ini menjadi .env untuk pengujian lokal:
# cp .env.example .env

# Lingkungan aplikasi (development / production / testing)
ENVIRONMENT=development
PORT=8001
HOST=127.0.0.1

# Provider LLM: 'mock' (default) atau 'gemini'
LLM_PROVIDER=mock

# Path file dataset sintetis (relatif terhadap root modul atau absolut)
INVENTORY_DATA_PATH=data/synthetic_inventory.json

# Konfigurasi Google Gemini API (Aktifkan saat LLM_PROVIDER=gemini)
# Dapatkan API Key di Google AI Studio: https://aistudio.google.com/
# GEMINI_API_KEY=your_gemini_api_key_here
# Model Gemini aktif saat ini (misal: gemini-2.5-flash, gemini-2.0-flash)
# GEMINI_MODEL_NAME=gemini-2.5-flash
# Batas waktu permintaan API Gemini dalam detik
# GEMINI_TIMEOUT_SECONDS=10.0
