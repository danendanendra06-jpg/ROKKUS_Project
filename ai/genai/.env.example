# Konfigurasi Layanan AI Inventory Assistant (ROKKUS Project)
# Salin file ini menjadi .env untuk pengujian lokal:
# cp .env.example .env

# Lingkungan aplikasi (development / production / testing)
ENVIRONMENT=development
PORT=8001
HOST=127.0.0.1

# Provider LLM: 'mock' (default saat ini) atau 'gemini' (masa depan)
LLM_PROVIDER=mock

# Path file dataset sintetis (relatif terhadap root modul atau absolut)
INVENTORY_DATA_PATH=data/synthetic_inventory.json

# Pengaturan masa depan (Google Gemini API - Belum digunakan pada tahap mock)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL_NAME=gemini-1.5-flash

